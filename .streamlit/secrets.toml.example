# Paste these root-level settings into Community Cloud > Advanced settings > Secrets.
# Replace the placeholder only in the hosting dashboard, never in GitHub.
OPENROUTER_API_KEY = "REPLACE_IN_STREAMLIT_DASHBOARD"
OPENROUTER_BASE_URL = "https://openrouter.ai/api/v1"
OPENROUTER_MODEL_NAME = "qwen/qwen3.7-flash"
EMBEDDING_PROVIDER = "openrouter"
OPENROUTER_EMBEDDING_MODEL = "baai/bge-m3"
PARSER_MODE = "strict_llamaparse"
MIN_RRF_SCORE = "0.02"
