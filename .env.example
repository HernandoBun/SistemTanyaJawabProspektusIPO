# ==================================================
# .env.example — Template API Keys
# Salin file ini menjadi .env dan isi dengan API key asli
# JANGAN commit file .env ke GitHub!
# ==================================================

# Dapatkan API key di: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model sesuai proposal final 535230133.pdf.
OPENROUTER_MODEL_NAME=qwen/qwen3.7-flash
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_TOKENS=2048

# Embedding Provider: 'openrouter' (baai/bge-m3 via API) atau 'local' (SentenceTransformer lokal)
EMBEDDING_PROVIDER=openrouter
OPENROUTER_EMBEDDING_MODEL=baai/bge-m3
EMBEDDING_BATCH_SIZE=32

# Optional: evaluator LLM used by RAGAS. Defaults to OPENROUTER_MODEL_NAME.
RAGAS_EVALUATOR_MODEL=qwen/qwen3.7-flash
RAGAS_EVALUATOR_MAX_TOKENS=2048
RAGAS_DO_NOT_TRACK=true

# Dapatkan gratis di: https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Research default: never mix LlamaParse and pdfplumber silently.
# Options: strict_llamaparse, llamaparse_fallback, pdfplumber
PARSER_MODE=strict_llamaparse

# Preprocessing konservatif: simbol keuangan, tabel, dan newline dipertahankan.
PREPROCESSING_ENABLED=true
PREPROCESS_REMOVE_REPEATED_EDGES=true
PREPROCESS_EDGE_LINES=3
PREPROCESS_REPEAT_RATIO=0.65
PREPROCESS_MIN_REPEAT_PAGES=3
PREPROCESS_MAX_BLANK_LINES=2

# Relevance threshold; calibrate on the development split.
MIN_RRF_SCORE=0.02
